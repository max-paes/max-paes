rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function supervisor() {
      return logado() &&
        get(/databases/$(database)/documents/vendedores/$(request.auth.uid)).data.papel == "supervisor";
    }

    // Perfil de cada vendedor
    match /vendedores/{uid} {
      allow read: if logado() && (request.auth.uid == uid || supervisor());
      // Ninguém se cadastra como supervisor: a conta nasce como "vendedor"
      allow create: if logado() && request.auth.uid == uid && request.resource.data.papel == "vendedor";
      // O vendedor atualiza o próprio perfil, mas não muda o papel. O supervisor pode mudar.
      allow update: if logado() && ((request.auth.uid == uid && request.resource.data.papel == resource.data.papel) || supervisor());
      allow delete: if false;

      // Pedidos, trocas, visitas, agenda e cadastro do vendedor
      match /docs/{doc} {
        allow read, write: if logado() && request.auth.uid == uid;
        allow read: if supervisor();
      }
    }

    // Painel do supervisor: leitura de todos os vendedores de uma vez
    match /{caminho=**}/docs/{doc} {
      allow read: if supervisor();
    }
  }
}
